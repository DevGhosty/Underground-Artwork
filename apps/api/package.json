{
  "name": "@underground-artwork/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @underground-artwork/shared",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run build -w @underground-artwork/shared && tsc -p tsconfig.json",
    "typecheck": "npm run build -w @underground-artwork/shared && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@underground-artwork/shared": "*",
    "@hono/node-server": "^1.19.1",
    "hono": "^4.11.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
