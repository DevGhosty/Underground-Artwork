{
  "name": "underground-artwork",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @underground-artwork/shared",
    "dev": "vite",
    "dev:api": "npm run dev -w @underground-artwork/api",
    "build": "npm run build -w @underground-artwork/shared && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test -w @underground-artwork/shared && npm run test -w @underground-artwork/api",
    "check": "npm run test && npm run build && npm run typecheck -w @underground-artwork/api"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
